# /etc/vizier/crawler.env, readable by root and the vizier user only.

# The Riot key lives in its own file so a renewed key needs no restart.
RIOT_API_KEY_FILE=/etc/vizier/riot-key
# Share of the key's rate limit the crawler may use; the Worker gets the rest.
RIOT_SHARE=0.7

VIZIER_DB=/var/lib/vizier/crawler.db

# Where finished stats are published: the Worker's D1 database.
CLOUDFLARE_ACCOUNT_ID=da1fe6d94089f79e601ad8b3b9cbfd66
CLOUDFLARE_D1_DATABASE_ID=3c95ce45-f597-46e1-81dc-68837d020be9
# A token with only Account > D1 > Edit.
CLOUDFLARE_API_TOKEN=
