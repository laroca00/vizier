{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vizier-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Clears expired cache rows once a day.
  "triggers": { "crons": ["0 4 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vizier",
      "database_id": "3c95ce45-f597-46e1-81dc-68837d020be9",
      "migrations_dir": "migrations"
    }
  ]
}
