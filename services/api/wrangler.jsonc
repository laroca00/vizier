{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vizier-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Every 2 minutes: crawl ranked games. 04:00 UTC: clear expired cache rows and old patches.
  "triggers": { "crons": ["*/2 * * * *", "0 4 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vizier",
      "database_id": "3c95ce45-f597-46e1-81dc-68837d020be9",
      "migrations_dir": "migrations"
    }
  ]
}
