{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vizier",
  "version": "0.8.5",
  "identifier": "com.vizier.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vizier",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3OEI1NEQ1MEE3N0JDRDMKUldUVHZIY0sxVlNMVnh4ejB0QS84NVA5b1MydmFsUmZSSXEzZDFyQXlGMjJ6VjRBM2ErTW1nYXIK",
      "endpoints": [
        "https://vizier-api.vizier-api.workers.dev/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
